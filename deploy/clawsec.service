[Unit]
Description=ClawSec Encrypted Network Tool
After=network.target

[Service]
Type=simple
User=clawsec
Group=clawsec
WorkingDirectory=/opt/clawsec
# The password is a systemd credential: put it in /etc/clawsec/password
# (root:root, mode 0600, e.g. `openssl rand -base64 24`). systemd exposes it
# to the service only, and it never appears on the command line.
LoadCredential=password:/etc/clawsec/password
ExecStart=/opt/clawsec/clawsec -l -p 8888 --key-file ${CREDENTIALS_DIRECTORY}/password
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/clawsec

[Install]
WantedBy=multi-user.target
