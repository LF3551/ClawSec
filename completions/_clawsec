#compdef clawsec

_clawsec() {
    _arguments \
        '-l[Listen mode for inbound connections]' \
        '-p[Local port number]:port:' \
        '-k[Encryption password (required)]:password:' \
        '-u[UDP mode (default: TCP)]' \
        '-4[Force IPv4 only]' \
        '-6[Force IPv6 only]' \
        '-c[Chat mode with timestamps and colors]' \
        '-v[Verbose output]' \
        '-w[Connection timeout in seconds]:seconds:' \
        '-K[Keep-open: accept multiple clients (fork per client)]' \
        '-L[Port forwarding target]:host\:port:' \
        '--obfs[Traffic obfuscation mode]:mode:(http tls)' \
        '--pad[Pad all packets to uniform 1400 bytes (anti-analysis)]' \
        '--jitter[Random delay between packets (ms)]:milliseconds:' \
        '--ech[Encrypted Client Hello (hide SNI from DPI)]' \
        '--mux[Multiplex streams over one encrypted tunnel]' \
        '--fallback[Proxy non-ClawSec probes to real site]:host\:port:' \
        '--fingerprint[Mimic browser TLS fingerprint]:profile:(chrome firefox safari)' \
        '--tofu[Trust On First Use - SSH-like server identity]' \
        '--pq[Post-quantum hybrid key exchange (SPAKE2 + ML-KEM-768)]' \
        '--key-file[Read the password from a file]:file:_files' \
        '--max-clients[With -K: concurrent handlers]:count' \
        '--max-per-ip[With -K: concurrent handlers per address]:count' \
        '--auth-fail-limit[With -K: block an address after n wrong passwords]:count' \
        '--handshake-timeout[Abort session setup after n seconds]:seconds' \
        '--scan-rate[SYN scan probes per second]:pps' \
        '--users[Server: per-user passwords file]:file:_files' \
        '--add-user[Add/change a user in the --users file]:name' \
        '--set-user[Change a user'"'"'s options]:name' \
        '--del-user[Remove a user]:name' \
        '--user-option[ip=, socks-allow=, disabled, none]:option' \
        '--user[Client: log in as this user]:name' \
        '--tun6[Server: IPv6 inside the tunnel]:ip6/prefix' \
        '--config[Read options from a file]:file:_files' \
        '--control[With -K: status socket]:path:_files' \
        '--status[Print a server status]:path:_files' \
        '--socks-allow[SOCKS server: allowed destination CIDRs]:cidr list' \
        '--tun[TUN VPN mode with IP/mask]:ip/mask:' \
        '--tun-udp[UDP data channel for VPN (avoids TCP-over-TCP)]' \
        '--version[Print version and wire protocol]' \
        '--masquerade[Enable NAT/masquerade on VPN server]' \
        '--default-route[Route all traffic through VPN tunnel]' \
        '--scan[Port scanner]:range:' \
        '-b[Banner grabbing during port scan]' \
        '--socks[SOCKS5 proxy through encrypted tunnel]:port:' \
        '--send[Send file through encrypted tunnel]:file:_files' \
        '--recv[Receive file into directory]:dir:_directories' \
        '-R[Reverse tunnel]:host\:port:' \
        '--persistent[Auto-reconnect with exponential backoff]' \
        '-z[Compress data with zlib before encryption]' \
        '-P[Show transfer progress bar]' \
        '-V[SHA-256 end-to-end file verification]' \
        '-n[Chat nickname]:name:' \
        '-e[Execute program after connect]:program:_command_names' \
        '-h[Display usage information]' \
        '*:host:_hosts'
}

_clawsec "$@"
